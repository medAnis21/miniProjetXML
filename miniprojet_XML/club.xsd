<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- ═══════════════════════════════════════════
       TYPES SIMPLES AVEC RESTRICTIONS
  ═══════════════════════════════════════════ -->

  <!-- ID catégorie : format C + chiffre(s) -->
  <xs:simpleType name="IdCategorie">
    <xs:restriction base="xs:ID">
      <xs:pattern value="C[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ID membre : format M + 3 chiffres -->
  <xs:simpleType name="IdMembre">
    <xs:restriction base="xs:ID">
      <xs:pattern value="M[0-9]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ID concours : format CO + chiffre(s) -->
  <xs:simpleType name="IdConcours">
    <xs:restriction base="xs:ID">
      <xs:pattern value="CO[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Chaîne non vide -->
  <xs:simpleType name="NonVide">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Email : doit contenir @ -->
  <xs:simpleType name="Email">
    <xs:restriction base="xs:string">
      <xs:pattern value="[^@]+@[^@]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Complexité : entier entre 0 et 100 -->
  <xs:simpleType name="Complexite">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="100"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Temps d'exécution : entier strictement positif -->
  <xs:simpleType name="TempsExecution">
    <xs:restriction base="xs:integer">
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Coefficient : décimal strictement positif -->
  <xs:simpleType name="Coefficient">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ═══════════════════════════════════════════
       TYPES COMPLEXES
  ═══════════════════════════════════════════ -->

  <!-- Type: <categorie id="Cx" libelle="..."/> -->
  <xs:complexType name="TypeCategorie">
    <xs:attribute name="id"      type="IdCategorie" use="required"/>
    <xs:attribute name="libelle" type="NonVide"      use="required"/>
  </xs:complexType>

  <!-- Type: <categories> -->
  <xs:complexType name="TypeCategories">
    <xs:sequence>
      <xs:element name="categorie" type="TypeCategorie" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Type: <membre> -->
  <xs:complexType name="TypeMembre">
    <xs:sequence>
      <xs:element name="nom"    type="NonVide"/>
      <xs:element name="prenom" type="NonVide"/>
      <xs:element name="email"  type="Email"/>
    </xs:sequence>
    <xs:attribute name="id"           type="IdMembre" use="required"/>
    <xs:attribute name="categorieRef" type="xs:IDREF" use="required"/>
  </xs:complexType>

  <!-- Type: <membres> -->
  <xs:complexType name="TypeMembres">
    <xs:sequence>
      <xs:element name="membre" type="TypeMembre" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Type: <participant> -->
  <xs:complexType name="TypeParticipant">
    <xs:sequence>
      <xs:element name="complexite"      type="Complexite"/>
      <xs:element name="tempsExecution"  type="TempsExecution"/>
    </xs:sequence>
    <xs:attribute name="membreRef" type="xs:IDREF" use="required"/>
  </xs:complexType>

  <!-- Type: <participants> -->
  <xs:complexType name="TypeParticipants">
    <xs:sequence>
      <xs:element name="participant" type="TypeParticipant"
                  minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Type: <concours> (l'élément interne) -->
  <xs:complexType name="TypeConcoursItem">
    <xs:sequence>
      <xs:element name="titre"        type="NonVide"/>
      <xs:element name="participants" type="TypeParticipants"/>
    </xs:sequence>
    <xs:attribute name="id"           type="IdConcours" use="required"/>
    <xs:attribute name="categorieRef" type="xs:IDREF"   use="required"/>
    <xs:attribute name="date"         type="xs:date"    use="required"/>
    <xs:attribute name="coefficient"  type="Coefficient" use="required"/>
  </xs:complexType>

  <!-- Type: <concours> (le conteneur racine) -->
  <xs:complexType name="TypeConcours">
    <xs:sequence>
      <xs:element name="concours" type="TypeConcoursItem"
                  minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ═══════════════════════════════════════════
       ÉLÉMENT RACINE
  ═══════════════════════════════════════════ -->
  <xs:element name="club">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="categories" type="TypeCategories"/>
        <xs:element name="membres"    type="TypeMembres"/>
        <xs:element name="concours"   type="TypeConcours"/>
      </xs:sequence>
      <xs:attribute name="nom" type="NonVide" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
